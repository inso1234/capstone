# Base URL of the running OrchardCore instance (no trailing slash).
ORCHARDCORE_BASE_URL=https://localhost:5001

# OAuth2 token endpoint. Defaults to "${ORCHARDCORE_BASE_URL}/connect/token" if omitted.
#ORCHARDCORE_TOKEN_URL=

# Client credentials for the dedicated McpTranslator OpenID application.
# See SETUP-ORCHARDCORE.md — never use the admin account here.
ORCHARDCORE_CLIENT_ID=mcp-translator
ORCHARDCORE_CLIENT_SECRET=

# GraphQL endpoint path. Defaults to "/api/graphql" if omitted.
#ORCHARDCORE_GRAPHQL_PATH=/api/graphql

# Comma-separated allow-list of content types the translator may read/create.
# Every type listed here must have a matching ViewOwn_<Type> (+ PublishOwn_<Type>
# for create_content) permission granted to the McpTranslator role.
ORCHARDCORE_ALLOWED_CONTENT_TYPES=BlogPost,Page

# Translator-side hard cap on page size, independent of OrchardCore's own
# GraphQL MaxNumberOfResults setting. Defaults to 50.
#ORCHARDCORE_MAX_PAGE_SIZE=50

# Per-request timeout in milliseconds for all calls to OrchardCore. Defaults to 10000.
#ORCHARDCORE_REQUEST_TIMEOUT_MS=10000
